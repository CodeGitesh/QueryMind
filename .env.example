# ── LLM API Keys ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here_optional

# ── LangSmith (optional tracing) ─────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_optional
LANGCHAIN_PROJECT=querymind

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-this-to-a-random-32-char-string-in-production
LOG_LEVEL=INFO

# ── Database (overridden in docker-compose) ───────────────────────────────────
DATABASE_URL=postgresql+asyncpg://querymind:querymind@localhost:5432/querymind

# ── Redis (overridden in docker-compose) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=30

# ── Demo Mode (SQLite fallback without PostgreSQL) ────────────────────────────
USE_SQLITE=false
